<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Nordlys.App</RootNamespace>
    <AssemblyName>Nordlys</AssemblyName>
    <ApplicationIcon>Assets\nordlys.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.5.1" />
    <PackageReference Include="WpfMath" Version="2.1.0" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nordlys.Core\Nordlys.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>
</Project>
